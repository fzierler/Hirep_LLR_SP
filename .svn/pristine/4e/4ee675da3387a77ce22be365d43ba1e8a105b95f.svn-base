GLB_X = 16
GLB_Y = 16
GLB_Z = 16
NP_T = 1
NP_X = 1
NP_Y = 1
NP_Z = 1
BC_SHIFT_X=0
BC_SHIFT_Y=0
BC_SHIFT_Z=0
// Replicas
N_REP = 1

// Random generator
rlx_level = 1
rlx_seed = 13813
rlx_start = new
rlx_state = rand_state

// Logger levels
log:default = 30
log:inverter = -1
log:forcestat = 0

// Fermion twisting
theta_T = 0.
theta_X = 0.
theta_Y = 0.
theta_Z = 0.

// HMC variables
tlen = 1.0

// Schroedinger functional
SF_zf = 1.
SF_ds = 1.
SF_ct = 1.
SF_sign = 1

// Runtime variables
//example: run1_8x8x8x8nc2rFUNnf0b0.000000m0.000000
therm =10
run name = run1
config dir = Cnfg
gauge start = random
rm steps = 0
rm restart = 1
Obs n meas = 10
meas freq = 2


// LLR
llr:make = true
llr:nmc = 100
llr:nth = 100
 
//Wilson flow parameters
WF:tmax = 120
WF:nmeas = 120
WF:nint=1000


// Monomials
monomial {
	id = 0
	type = llr
	E0 = 233847.6666
	de = 166.6666
	arho = -6.0085
	level = 0
}

